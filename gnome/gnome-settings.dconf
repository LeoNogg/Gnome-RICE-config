[desktop/background]
picture-options='zoom'

[desktop/interface]
accent-color='slate'
color-scheme='prefer-dark'
cursor-theme='Bibata-Modern-Ice'
gtk-theme='MacTahoe-Light-grey'
icon-theme='Colloid'

[desktop/wm/preferences]
action-right-click-titlebar='menu'
button-layout='appmenu:minimize,maximize,close'

[shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'blur-my-shell@aunetx', 'dash-to-dock@micxgx.gmail.com']

[shell/extensions/blur-my-shell]
rounded-blur-found=false
settings-version=2

[shell/extensions/blur-my-shell/appfolder]
brightness=1.0
sigma=30
style-dialogs=2

[shell/extensions/blur-my-shell/applications]
blacklist=['Plank', 'com.desktop.ding', 'Conky', 'org.gnome.Shell.Extensions']
blur=true
blur-on-overview=true
dynamic-opacity=false
enable-all=true
opacity=255
pipeline='pipeline_default_rounded'
static-blur=true

[shell/extensions/blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
override-background=false
pipeline='pipeline_default_rounded'
sigma=30
static-blur=true
style-dash-to-dock=0
unblur-in-overview=true

[shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default_rounded'

[shell/extensions/blur-my-shell/overview]
pipeline='pipeline_default'
style-components=0

[shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
pipeline='pipeline_default'
sigma=30

[shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default_rounded'

[shell/extensions/blur-my-shell/window-list]
brightness=1.0
sigma=50

[shell/extensions/dash-to-dock]
background-opacity=0.80000000000000004
custom-background-color=false
dash-max-icon-size=36
dock-position='BOTTOM'
height-fraction=0.90000000000000002
show-apps-always-in-the-edge=true
show-show-apps-button=false

[shell/extensions/user-theme]
name='MacTahoe-Dark-grey'
