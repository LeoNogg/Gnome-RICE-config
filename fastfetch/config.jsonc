{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/home/user/.config/fastfetch/ascii.txt",
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": {
        "user": "#C79A52",
        "at": "#A89B88",
        "host": "#D8C5A1"
      }
    },

        {
      "type": "separator",
      "string": "──────────────"
    },

    "break",

    {
      "type": "os",
      "key": "󰣇",
      "keyColor": "#C79A52"
    },

    {
      "type": "cpu",
      "key": "",
      "keyColor": "#D8C5A1"
    },

    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#B57A3D"
    },

    {
      "type": "memory",
      "key": "",
      "keyColor": "#78845B",
      "format": "{used} / {total} ({percentage})"
    },

    {
      "type": "disk",
      "key": "",
      "keyColor": "#C79A52"
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
